{
  "name": "stardeck",
  "version": "0.10.0",
  "private": true,
  "description": "Stardeck — a free, local-first social design & carousel studio. Create. Swipe. Flex.",
  "scripts": {
    "dev": "node scripts/build-workers.mjs && node scripts/build-templates.mjs && node scripts/build-trends.mjs && next dev",
    "build": "node scripts/build-workers.mjs && node scripts/build-templates.mjs && node scripts/build-trends.mjs && next build && node scripts/build-sw.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs",
    "fonts": "node scripts/sync-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "workers": "node scripts/build-workers.mjs",
    "templates": "node scripts/build-templates.mjs --author",
    "templates:check": "node scripts/check-templates.mjs",
    "trends": "node scripts/build-trends.mjs",
    "trends:check": "node scripts/build-trends.mjs --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gifenc": "^1.0.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "mp4-muxer": "^5.2.2",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/rubik-mono-one": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/unifrakturmaguntia": "^5.3.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "onnxruntime-web": "^1.30.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
